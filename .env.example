# Copy to .env and fill in real values. Never commit .env (already gitignored).

# SSI FastConnect credentials — from SSI FastConnect portal.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_API_KEY=
SSI_API_SECRET=
# PEM private key content for the FastConnect account (used to sign real
# order requests). Keep this out of git and out of logs.
SSI_PRIVATE_KEY=

# PostgreSQL connection string used by engine/collector (docker-compose sets
# this to the internal service DNS name; only override for local/non-docker runs).
DB_DSN=postgresql://trading:trading@localhost:5432/trading

# Telegram alerts (optional — WARN/CRITICAL alerts are skipped if unset).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
