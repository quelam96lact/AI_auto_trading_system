# Copy to .env and fill in real values. Never commit .env (already gitignored).

# SSI FastConnect credentials — from SSI FastConnect portal.
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_API_KEY=
SSI_API_SECRET=
# PEM private key content for the FastConnect account (used to sign real
# order requests). Keep this out of git and out of logs.
SSI_PRIVATE_KEY=

# PostgreSQL connection string used by engine/collector (docker-compose sets
# this to the internal service DNS name; only override for local/non-docker runs).
DB_DSN=postgresql://trading:trading@localhost:5432/trading

# NATS server URL (docker-compose sets this to nats://nats:4222; only override for local/host runs).
# NATS_URL=nats://localhost:4222

# Telegram alerts (optional — WARN/CRITICAL alerts are skipped if unset).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres password. Mac dinh 'trading' de tuong thich voi volume pgdata da
# khoi tao san. Doi gia tri nay CHI co tac dung khi khoi tao volume LAN DAU —
# neu DB da ton tai, phai ALTER USER trong Postgres roi moi doi o day.
POSTGRES_PASSWORD=trading

# Password admin cua Grafana. Grafana chi bind 127.0.0.1 nen khong lo ra
# internet, nhung van nen doi khoi mac dinh truoc khi deploy.
GRAFANA_ADMIN_PASSWORD=admin

# BingX API credentials — tao tren BingX API Management (chi bat quyen Read).
BINGX_API_KEY=
BINGX_API_SECRET=
# Thu muc chua ban sao luu (backup_db.sh, backup_orderbook.sh, backup_check.py, disk_check.py).
# Bo trong tren VPS Ubuntu de dung mac dinh /var/backups/trading-db.
# TREN WINDOWS BAT BUOC dat: duong dan Ubuntu vua khong ton tai, vua bi Git Bash
# dich thanh 'C:\Program Files\Git\var\...' (do that 29/09).=
